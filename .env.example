# Neon pooled connection string (same locally and on Vercel). Never prefix with VITE_
DATABASE_URL=

# Shared app password. Never prefix with VITE_
APP_PASSWORD=

# Random string used to sign the session cookie
SESSION_SECRET=

PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Optional catalog lookups (server-only). TMDB for movies/series, RAWG for games.
TMDB_API_KEY=
RAWG_API_KEY=
